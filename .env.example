# File .env cho Docker Compose (đặt cùng cấp với docker-compose.yml)
# Mật khẩu SA của SQL Server (tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt)
SA_PASSWORD=YourStrong@Passw0rd
# Tên database sẽ được tự động tạo
MSSQL_DATABASE=LandingDB
# Khóa ký JWT (nên đổi thành chuỗi ngẫu nhiên dài khi triển khai thật)
JWT_SECRET=dev_secret_change_me
# Mật khẩu đăng nhập trang admin (mặc định seed là admin123 — BẮT BUỘC đặt khi public ra internet)
ADMIN_PASSWORD=
# Địa chỉ API mà trình duyệt của khách truy cập sẽ gọi (nhúng vào frontend lúc BUILD).
# Khi public ra internet: http://<IP-server>:3000 — đổi xong phải build lại
PUBLIC_API_URL=http://localhost:3000
