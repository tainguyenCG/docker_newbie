---
import '../styles/global.css';

const { title = 'Landing Page', description = 'Landing Page demo - Astro + Node.js + MSSQL + Docker' } = Astro.props;
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-slate-800 antialiased">
    <header class="fixed top-0 inset-x-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href="/" class="text-xl font-bold text-indigo-600">My Landing</a>
        <div class="hidden gap-6 text-sm font-medium sm:flex">
          <a href="#about" class="hover:text-indigo-600">Giới thiệu</a>
          <a href="#features" class="hover:text-indigo-600">Tính năng</a>
          <a href="#contact" class="hover:text-indigo-600">Liên hệ</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500">
      &copy; 2026 My Landing &mdash; Demo Astro + Node.js + MSSQL + Docker
    </footer>
  </body>
</html>
