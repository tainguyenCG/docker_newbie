---
import Layout from '../layouts/Layout.astro';

const features = [
  { n: 1, title: 'Hieu nang cao', desc: 'Astro toi uu toc do tai trang, zero-JS mac dinh cho trang tinh.' },
  { n: 2, title: 'De dang trien khai', desc: 'Toan bo he thong chay bang mot lenh: docker compose up.' },
  { n: 3, title: 'Quan tri noi dung', desc: 'Admin panel cho phep chinh sua toan bo noi dung landing page.' },
];
---

<Layout>
  <main class="pt-16">
    <!-- Hero -->
    <section id="hero" class="bg-gradient-to-br from-indigo-600 via-indigo-500 to-violet-600 text-white">
      <div class="mx-auto max-w-6xl px-4 py-28 text-center md:py-36">
        <h1 data-field="hero:Title" class="text-4xl font-extrabold leading-tight md:text-6xl">
          Chao mung den voi Landing Page
        </h1>
        <p data-field="hero:Subtitle" class="mx-auto mt-6 max-w-3xl text-lg text-indigo-100 md:text-2xl">
          Giai phap Full-Stack: Astro + Node.js + MSSQL chay cung Docker
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a href="#features" class="rounded-lg bg-white px-6 py-3 font-semibold text-indigo-700 hover:bg-indigo-50">
            Xem tính năng
          </a>
          <a href="#contact" class="rounded-lg border border-white/60 px-6 py-3 font-semibold hover:bg-white/10">
            Liên hệ
          </a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="py-20">
      <div class="mx-auto max-w-4xl px-4 text-center">
        <h2 data-field="about:Title" class="text-3xl font-bold md:text-4xl">Ve chung toi</h2>
        <p data-field="about:Description" class="mt-6 text-lg leading-relaxed text-slate-600">
          Chung toi xay dung cac ung dung web hien dai, nhanh chong va dang tin cay.
        </p>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="bg-slate-50 py-20">
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid gap-8 md:grid-cols-3">
          {
            features.map((f) => (
              <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:shadow-md">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100 text-xl font-bold text-indigo-600">
                  {f.n}
                </div>
                <h3 data-field={`feature_${f.n}:Title`} class="text-xl font-semibold">
                  {f.title}
                </h3>
                <p data-field={`feature_${f.n}:Description`} class="mt-3 text-slate-600">
                  {f.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-20">
      <div class="mx-auto max-w-3xl px-4 text-center">
        <h2 data-field="contact:Title" class="text-3xl font-bold md:text-4xl">Lien he</h2>
        <p data-field="contact:Subtitle" class="mt-4 text-lg text-slate-600">
          Email: contact@example.com | Dien thoai: 0123 456 789
        </p>
      </div>
    </section>
  </main>
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

  async function loadContent() {
    try {
      const res = await fetch(`${API_URL}/api/content`);
      if (!res.ok) return;
      const items = await res.json();
      const map = Object.fromEntries(items.map((i) => [i.SectionKey, i]));
      document.querySelectorAll('[data-field]').forEach((el) => {
        const [key, field] = (el.dataset.field || '').split(':');
        const item = map[key];
        const value = item && item[field];
        if (value) el.textContent = value;
      });
    } catch {
      console.warn('Khong tai duoc noi dung tu API, hien thi noi dung mac dinh.');
    }
  }

  loadContent();
</script>
